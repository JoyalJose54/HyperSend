<Window x:Class="HyperSend.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HyperSend" Height="720" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0D1B2A" Foreground="White"
        FontFamily="Segoe UI" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>

        <!-- Gradient background brush -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1B2A" Offset="0"/>
            <GradientStop Color="#1B2838" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#334FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A2744"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3F5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#4FC3F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card border style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12264A"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Stat card style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#0D1E38"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <!-- ListView style -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar style (thin dark) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- Pulsing animation for Idle panel -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.85" To="1.15" Duration="0:0:1.8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.85" To="1.15" Duration="0:0:1.8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0.15" Duration="0:0:1.8" AutoReverse="True"/>

            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.9" To="1.1" Duration="0:0:2.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.9" To="1.1" Duration="0:0:2.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.1" Duration="0:0:2.2" AutoReverse="True"/>
        </Storyboard>

        <!-- Flow dot animation (TransferPanel) -->
        <Storyboard x:Key="FlowDot1Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowDot1"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0"/>
        </Storyboard>
        <Storyboard x:Key="FlowDot2Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowDot2"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="FlowDot3Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowDot3"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.30"/>
        </Storyboard>
        <Storyboard x:Key="FlowDot4Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowDot4"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.45"/>
        </Storyboard>
        <Storyboard x:Key="FlowDot5Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowDot5"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.60"/>
        </Storyboard>

    </Window.Resources>

    <!-- Background gradient -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D1B2A" Offset="0"/>
                <GradientStop Color="#1B2838" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ═══════════════════════════════════════════════════════
             PANEL 1: IDLE
             ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="IdlePanel" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="24,20,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="HyperSend" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- PC Hostname badge -->
                <Border Grid.Column="1" Background="#1A2744" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHostname" Text="PC-NAME" FontSize="12" Foreground="#8899BB"/>
                </Border>
            </Grid>

            <!-- CENTER: Pulsing circle + action buttons -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                <!-- Pulsing ring animation -->
                <Grid Width="180" Height="180" Margin="0,0,0,28">
                    <!-- Outer ring (biggest) -->
                    <Ellipse x:Name="PulseRing1" Width="160" Height="160"
                             Stroke="#4FC3F7" StrokeThickness="2" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Middle ring -->
                    <Ellipse x:Name="PulseRing2" Width="120" Height="120"
                             Stroke="#26C6DA" StrokeThickness="2" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Inner filled circle -->
                    <Ellipse Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#0288D1" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Lightning bolt icon -->
                    <TextBlock Text="⚡" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White"/>
                </Grid>

                <TextBlock Text="Ultra-Fast P2P Transfer" FontSize="14" Foreground="#6688AA"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Send to Phone button -->
                <Button x:Name="BtnSendToPhone"
                        Style="{StaticResource PrimaryButton}"
                        Width="260" Height="64"
                        Padding="0" Margin="0,0,0,14"
                        Click="BtnSendToPhone_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Send to Phone" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Receive from Phone button -->
                <Button x:Name="BtnReceiveFromPhone"
                        Style="{StaticResource OutlineButton}"
                        Width="260" Height="64"
                        Padding="0"
                        Click="BtnReceiveFromPhone_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Receive from Phone" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- BOTTOM STATUS BAR -->
            <Border Grid.Row="2" Background="#0A1628" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#66BB6A" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtLinkStatus" Text="Detecting link..." FontSize="12" Foreground="#8899BB"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtLocalIp" Grid.Column="1" Text="" FontSize="12" Foreground="#4FC3F7"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             PANEL 2: PAIRING  (Receiver sub-state + Sender sub-state)
             ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="PairingPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back header -->
            <Grid Grid.Row="0" Margin="24,20,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back" Style="{StaticResource PrimaryButton}"
                        Background="#1A2744" Foreground="#4FC3F7" Padding="14,8" FontSize="13"
                        Click="BtnPairingBack_Click"/>
                <TextBlock x:Name="TxtPairingTitle" Grid.Column="1" Text="Connect"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- ——— RECEIVER sub-state ——— -->
            <Grid x:Name="ReceiverSubPanel" Grid.Row="1" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Waiting for connection..." FontSize="18" Foreground="#8899BB"
                               HorizontalAlignment="Center" Margin="0,0,0,32"/>

                    <!-- PIN card with glow ring -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                        <!-- Glow ring  -->
                        <Ellipse x:Name="PinRingOuter" Width="230" Height="230"
                                 Stroke="#4FC3F7" StrokeThickness="2" Fill="Transparent"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>

                        <Border Style="{StaticResource Card}" Width="210" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Your PIN" FontSize="12" Foreground="#6688AA"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtPinDisplay" Text="------"
                                           FontSize="56" FontWeight="Bold"
                                           Foreground="#4FC3F7" HorizontalAlignment="Center"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Enter this PIN on the PC app" FontSize="13" Foreground="#6688AA"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ——— SENDER sub-state ——— -->
            <Grid x:Name="SenderSubPanel" Grid.Row="1" Visibility="Collapsed" Margin="40,10,40,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- IP + PIN fields -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Phone IP Address" FontSize="12" Foreground="#6688AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPhoneIp" Text="" Margin="0,0,0,12"/>
                        <TextBlock Text="6-Digit PIN" FontSize="12" Foreground="#6688AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPin" MaxLength="6" TextAlignment="Center"
                                 FontWeight="Bold" FontSize="20" Foreground="#4FC3F7"/>
                        <Button Content="⚡  Connect &amp; Send →"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,14,0,0" Height="48"
                                Click="BtnConnectAndSend_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- File drop zone -->
                <Border Grid.Row="1" Background="#0D1E38" BorderBrush="#2A3F5F" BorderThickness="2"
                        CornerRadius="12" Padding="20,16" Margin="0,0,0,10"
                        Cursor="Hand" MouseDown="DropZone_MouseDown">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Drop files here or click to browse" FontSize="13"
                                   Foreground="#8899BB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- File list -->
                <ListView Grid.Row="2" x:Name="FileList" MaxHeight="150">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,2">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" FontSize="14"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Width="200" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplaySize}" Foreground="#6688AA" FontSize="11" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding Status}" Foreground="#4FC3F7" FontSize="11" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="+ Add Files" Style="{StaticResource PrimaryButton}"
                            Background="#1A2744" Foreground="#4FC3F7"
                            Padding="14,8" Margin="0,0,8,0" Click="BtnAddFiles_Click"/>
                    <Button Content="Clear" Style="{StaticResource PrimaryButton}"
                            Background="#1A2744" Foreground="#8899BB"
                            Padding="14,8" Click="BtnClearFiles_Click"/>
                </StackPanel>
            </Grid>

            <!-- Cancel button -->
            <Button Grid.Row="2" Content="Cancel" Style="{StaticResource OutlineButton}"
                    Width="160" Height="44" Margin="0,16,0,24" HorizontalAlignment="Center"
                    Click="BtnPairingBack_Click"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             PANEL 3: TRANSFER  (Live dashboard)
             ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="TransferPanel" Visibility="Collapsed" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Device row -->
                <RowDefinition Height="Auto"/>
                <!-- Arc progress -->
                <RowDefinition Height="Auto"/>
                <!-- File + progress bar -->
                <RowDefinition Height="Auto"/>
                <!-- Stats row -->
                <RowDefinition Height="Auto"/>
                <!-- Target + cancel -->
            </Grid.RowDefinitions>

            <!-- DEVICE ROW -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PC card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10" CornerRadius="14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💻" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtDevicePcName" Text="This PC" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="PcRoleBadge" Background="#1A2563EB" CornerRadius="8" Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPcRole" Text="SENDING" FontSize="10" FontWeight="Bold" Foreground="#4FC3F7"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Animated flow dots -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Ellipse x:Name="FlowDot1" Width="8" Height="8" Fill="#4FC3F7" Margin="3,0"/>
                    <Ellipse x:Name="FlowDot2" Width="8" Height="8" Fill="#4FC3F7" Margin="3,0"/>
                    <Ellipse x:Name="FlowDot3" Width="8" Height="8" Fill="#4FC3F7" Margin="3,0"/>
                    <Ellipse x:Name="FlowDot4" Width="8" Height="8" Fill="#4FC3F7" Margin="3,0"/>
                    <Ellipse x:Name="FlowDot5" Width="8" Height="8" Fill="#4FC3F7" Margin="3,0"/>
                </StackPanel>

                <!-- Phone card -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10" CornerRadius="14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Samsung Galaxy" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <Border x:Name="PhoneRoleBadge" Background="#1A26C6DA" CornerRadius="8" Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPhoneRole" Text="RECEIVING" FontSize="10" FontWeight="Bold" Foreground="#26C6DA"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BIG CIRCULAR PROGRESS ARC -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Canvas x:Name="ArcCanvas" Width="280" Height="280">
                    <!-- Background track -->
                    <Path x:Name="ArcBackground" Stroke="#1A2744" StrokeThickness="16"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    <!-- Progress arc -->
                    <Path x:Name="ProgressArcPath" StrokeThickness="16"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4FC3F7" Offset="0"/>
                                <GradientStop Color="#26C6DA" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <!-- Center content -->
                    <StackPanel Canvas.Left="70" Canvas.Top="88" Width="140">
                        <TextBlock x:Name="TxtLiveSpeed" Text="0.0" FontSize="48" FontWeight="Bold"
                                   Foreground="#4FC3F7" HorizontalAlignment="Center" LineHeight="52"/>
                        <TextBlock Text="MB/s" FontSize="16" Foreground="#6688AA"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Canvas>
            </Grid>

            <!-- File name + linear progress bar -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock x:Name="TxtCurrentFile" Text="Preparing..."
                           FontSize="13" Foreground="#8899BB" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="500" Margin="0,0,0,8"/>
                <Border Background="#0D1E38" CornerRadius="6" Height="10" Margin="4,0">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="6" RadiusY="6" Rect="0,0,520,10"/>
                    </Border.Clip>
                    <Grid>
                        <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" CornerRadius="6" Height="10" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4FC3F7" Offset="0"/>
                                    <GradientStop Color="#26C6DA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- STATS ROW -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Avg Speed" FontSize="11" Foreground="#6688AA" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtAvgSpeed" Text="0.0 MB/s" FontSize="20" FontWeight="Bold" Foreground="#26C6DA"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Transferred" FontSize="11" Foreground="#6688AA" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTransferred" Text="0 MB" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="ETA" FontSize="11" Foreground="#6688AA" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtEta" Text="--" FontSize="20" FontWeight="Bold" Foreground="#4FC3F7"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TARGET LINE + CANCEL -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTargetLabel" Text="🎯 Target: ≥90 MB/s"
                               FontSize="13" Foreground="#6688AA"/>
                    <TextBlock x:Name="TxtTargetStatus" Text="" FontSize="12" Foreground="#66BB6A"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnCancelTransfer"
                        Content="⛔  Stop Transfer"
                        Style="{StaticResource PrimaryButton}"
                        Background="#C0392B" Padding="18,10"
                        Click="BtnCancelTransfer_Click"/>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             PANEL 4: COMPLETE
             ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">

                <!-- Green check circle -->
                <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse Width="96" Height="96" Fill="#1A66BB6A"/>
                    <Ellipse Width="80" Height="80" Fill="#66BB6A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="✓" FontSize="44" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Transfer Complete!" FontSize="28" FontWeight="Bold"
                           Foreground="#66BB6A" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Summary card -->
                <Border Style="{StaticResource Card}" Width="380" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Speed" FontSize="11" Foreground="#6688AA" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCompleteSpeed" Text="0 MB/s" FontSize="22" FontWeight="Bold"
                                       Foreground="#4FC3F7" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Size" FontSize="11" Foreground="#6688AA" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCompleteSize" Text="0 MB" FontSize="22" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Time" FontSize="11" Foreground="#6688AA" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCompleteTime" Text="0s" FontSize="22" FontWeight="Bold"
                                       Foreground="#26C6DA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Trophy badge -->
                <Border x:Name="TrophyBadge" Visibility="Collapsed"
                        Background="#1A66BB6A" BorderBrush="#66BB6A" BorderThickness="1"
                        CornerRadius="12" Padding="20,10" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="🏆  Target Exceeded!" FontSize="16" FontWeight="Bold" Foreground="#66BB6A"/>
                </Border>

                <Button Content="Done" Style="{StaticResource PrimaryButton}"
                        Width="200" Height="52" Margin="0,8,0,0"
                        Click="BtnDone_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
